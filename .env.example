DATABASE_URL=postgres://dorak:dorak_local_only@localhost:5432/dorak
# Optional direct/unpooled URL for Better Auth when DATABASE_URL is a Neon pooled endpoint.
BETTER_AUTH_DATABASE_URL=
DATABASE_POOL_MAX=5
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
DORAK_CONTACT_EMAIL=replace-with-your-contact-email
DORAK_ALLOW_INDEXING=false
DORAK_DEMO_AUTH=true
DORAK_OPS_USERNAME=dorak-operator
DORAK_OPS_PASSWORD=replace-with-a-long-random-password
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=replace-with-kakao-javascript-key
SEOUL_OPEN_DATA_KEY=optional-seoul-open-api-key-for-import
